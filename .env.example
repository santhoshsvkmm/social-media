# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=wowonder
MYSQL_USER=wowonder_user
MYSQL_PASSWORD=wowonder_pass

# Redis Configuration
REDIS_PASSWORD=redis_password

# PHP Configuration
PHP_MEMORY_LIMIT=256M
PHP_MAX_UPLOAD_SIZE=50M

# Site Configuration
SITE_URL=http://localhost
PURCHASE_CODE=docker-development
SITE_KEY=change_this_to_a_secure_random_key

# Node.js Configuration
NODE_ENV=production

# Docker Image Configuration
DOCKER_REPO=wowonder
IMAGE_TAG=latest

# Docker Compose Profile
# Uncomment to enable real-time server: realtime
# COMPOSE_PROFILES=realtime
